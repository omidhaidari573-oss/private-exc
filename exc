-- Open/Close animations
local function animateOpen()
	MainGUI.Visible = true
	MainGUI.Position = UDim2.new(0.5, -guiWidth/2, -0.5, -guiHeight/2)
	TweenService:Create(MainGUI, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, -guiWidth/2, 0.5, -guiHeight/2)
	}):Play()
end

local function animateClose()
	local tween = TweenService:Create(MainGUI, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
		Position = UDim2.new(0.5, -guiWidth/2, -0.5, -guiHeight/2)
	})
	tween:Play()
	tween.Completed:Wait()
	MainGUI.Visible = false
end

AppIcon.MouseButton1Click:Connect(function()
	if MainGUI.Visible then animateClose() else animateOpen() end
end)
