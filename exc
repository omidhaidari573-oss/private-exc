	if text ~= "" then
		local name = text:sub(1,10)
		local counter = 1
		local originalName = name
		while savedScripts[name] do
			counter = counter + 1
			name = originalName.."_"..counter
		end
		savedScripts[name] = text
		refreshExtraSection()
		print("Saved script:", name)
	end
end)

