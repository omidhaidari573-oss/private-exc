--// Auto-Complete (fixed + navigation)
local keywords = {
	"local","function","if","then","end","for","while","repeat","until","return","break","do","else","elseif",
	"print","warn","wait","game","workspace","Players","CFrame","Vector3","Humanoid","Instance","Enum"
}

-- AutoFrame (container)
local AutoFrame = Instance.new("Frame")
AutoFrame.Parent = MainGUI
AutoFrame.Size = UDim2.new(0.9,0,0,0) -- height set dynamically
AutoFrame.Position = UDim2.new(0.05,0,0,0) -- will be updated under editor
AutoFrame.BackgroundTransparency = 1
AutoFrame.Visible = false
AutoFrame.ZIndex = 10
local autoCorner = Instance.new("UICorner", AutoFrame)
autoCorner.CornerRadius = UDim.new(0,8)

-- Internal state for suggestions
local suggestions = {}
local selectedIndex = 0
local maxVisible = 6
local rowHeight = 22

local function getCurrentWord(text)
	-- get word under / before caret: we'll approximate with trailing word
	return text:match("[%w_]+$") or ""
end

local function clearSuggestions()
	for _, child in ipairs(AutoFrame:GetChildren()) do
		if child:IsA("TextButton") or child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	suggestions = {}
	selectedIndex = 0
end

local function highlightSelection(index)
	-- index is 1-based
	for i, child in ipairs(AutoFrame:GetChildren()) do
		if child:IsA("TextButton") then
			if i == index then
				child.BackgroundTransparency = 0
				child.BackgroundColor3 = Color3.fromRGB(60,60,60)
			else
				child.BackgroundTransparency = 1
			end
		end
	end
end

local function applySelection(index, word)
	if index < 1 or index > #suggestions then return end
	local k = suggestions[index]
	-- replace current word with k
	Editor.Text = Editor.Text:sub(1, #Editor.Text - #word) .. k
	AutoFrame.Visible = false
	clearSuggestions()
end

local function updateAutoComplete()
	local word = getCurrentWord(Editor.Text)
	if word == "" then
		AutoFrame.Visible = false
		clearSuggestions()
		return
	end

	-- collect matches
	local matches = {}
	for _, k in ipairs(keywords) do
		if k:sub(1, #word) == word then
			table.insert(matches, k)
		end
	end

	if #matches == 0 then
		AutoFrame.Visible = false
		clearSuggestions()
		return
	end

	-- set suggestions
	suggestions = matches

	-- Determine position: place just below the editor (using scale positions)
	local editorBottomY = Editor.Position.Y.Scale + Editor.Size.Y.Scale
	-- add tiny padding (0.01)
	AutoFrame.Position = UDim2.new(0.05, 0, editorBottomY + 0.01, 0)

	-- Height depends on number of visible items
	local visibleCount = math.min(#suggestions, maxVisible)
	local totalHeight = visibleCount * rowHeight
	AutoFrame.Size = UDim2.new(0.9, 0, 0, totalHeight)
	AutoFrame.Visible = true

	-- Clear old and create new entries
	clearSuggestions()
	for i = 1, visibleCount do
		local k = suggestions[i]
		local btn = Instance.new("TextButton")
		btn.Name = "AutoItem_"..i
		btn.Parent = AutoFrame
		btn.Size = UDim2.new(1, 0, 0, rowHeight)
		btn.Position = UDim2.new(0, 0, 0, (i-1) * rowHeight)
		btn.BackgroundTransparency = 1
		btn.Text = "  " .. k -- padding left
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.TextColor3 = Color3.new(1,1,1)
		btn.Font = Enum.Font.Gotham
		btn.TextScaled = true
		btn.ZIndex = 11

		-- Mouse hover highlight
		btn.MouseEnter:Connect(function()
			highlightSelection(i)
			selectedIndex = i
		end)
		btn.MouseLeave:Connect(function()
			-- remove highlight when leaving (unless it's selected)
			highlightSelection(selectedIndex)
		end)

		btn.MouseButton1Click:Connect(function()
			applySelection(i, word)
		end)
	end

	-- reset selected index
	selectedIndex = 1
	highlightSelection(selectedIndex)
end

-- Key navigation: Up/Down/Enter/Tab
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if not AutoFrame.Visible then return end

	if input.KeyCode == Enum.KeyCode.Down then
		if #suggestions > 0 then
			selectedIndex = math.min(selectedIndex + 1, math.min(#suggestions, maxVisible))
			highlightSelection(selectedIndex)
		end
	elseif input.KeyCode == Enum.KeyCode.Up then
		if #suggestions > 0 then
			selectedIndex = math.max(selectedIndex - 1, 1)
			highlightSelection(selectedIndex)
		end
	elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.Enter then
		if #suggestions > 0 and selectedIndex > 0 then
			local word = getCurrentWord(Editor.Text)
			applySelection(selectedIndex, word)
		end
	elseif input.KeyCode == Enum.KeyCode.Tab then
		-- consume tab for autocomplete
		if #suggestions > 0 and selectedIndex > 0 then
			local word = getCurrentWord(Editor.Text)
			applySelection(selectedIndex, word)
		end
	end
end)

-- Update on text change
Editor:GetPropertyChangedSignal("Text"):Connect(updateAutoComplete)

-- Make sure clicking outside closes autocomplete
MainGUI.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		-- If AutoFrame visible and click is outside AutoFrame and Editor, close it
		local mouse = UserInputService:GetMouseLocation()
		-- mouse returns Vector2 in screen coordinates; we won't do pixel-perfect check here (roblox specifics vary),
		-- but simplest approach: hide autocomplete if click is below the editor bottom (i.e., likely on buttons),
		-- otherwise leave it.
		local viewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800,600)
		-- compute editor bottom pixel Y:
		local guiPos = MainGUI.AbsolutePosition
		local editorAbsPos = Editor.AbsolutePosition
		local editorAbsSize = Editor.AbsoluteSize
		if AutoFrame.Visible and (mouse.Y > (editorAbsPos.Y + editorAbsSize.Y + 10)) then
			AutoFrame.Visible = false
			clearSuggestions()
		end
	end
end)

