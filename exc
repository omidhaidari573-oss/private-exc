local function refreshExtraSection()
	for _, child in ipairs(ExtraSection:GetChildren()) do
		if child:IsA("TextButton") and child ~= ExtraClose then
			child:Destroy()
		end
	end
	
	local index = 1
	for name, code in pairs(savedScripts) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0.9,0,0,30)
		btn.Position = UDim2.new(0.05,0,0,30 * index + 25)
		btn.Text = name
		btn.Font = Enum.Font.Gotham
		btn.TextScaled = true
		btn.TextColor3 = Color3.new(1,1,1)
		btn.BackgroundTransparency = 0.2
		btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
		btn.Parent = ExtraSection
		
		btn.MouseEnter:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(80,80,80)}):Play()
		end)
		btn.MouseLeave:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50,50,50)}):Play()
		end)
		
		btn.MouseButton1Click:Connect(function()
			Editor.Text = code
			closeExtraSection()
		end)
		
		btn.MouseButton2Click:Connect(function()
			savedScripts[name] = nil
			refreshExtraSection()
		end)
		
		index = index + 1
	end
end

SaveButton.MouseButton1Click:Connect(function()
