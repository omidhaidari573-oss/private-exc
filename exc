-- Hover animation for buttons
local function addHoverEffect(button)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255,182,193)}):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.2), {TextColor3 = Color3.new(1,1,1)}):Play()
	end)
end
addHoverEffect(Execute)
addHoverEffect(Clear)
addHoverEffect(CloseButton)

-- Open/Close animations
local function animateOpen()
	MainGUI.Visible = true
	MainGUI.Position = UDim2.new(0.5, -guiWidth/2, -0.5, -guiHeight/2)
	TweenService:Create(MainGUI, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, -guiWidth/2, 0.5, -guiHeight/2)
	}):Play()
end

local function animateClose()
	local tween = TweenService:Create(MainGUI, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
		Position = UDim2.new(0.5, -guiWidth/2, -0.5, -guiHeight/2)
	})
	tween:Play()
	tween.Completed:Wait()
	MainGUI.Visible = false
end

AppIcon.MouseButton1Click:Connect(function()
	if MainGUI.Visible then animateClose() else animateOpen() end
end)
CloseButton.MouseButton1Click:Connect(animateClose)

-- Execute script safely
Execute.MouseButton1Click:Connect(function()
	local code = Editor.Text
	if code ~= "" then
		local success, err = pcall(function()
			if string.match(code, "^https?://") then
				local response = game:HttpGet(code)
				loadstring(response)()
			else
				loadstring(code)()
			end
		end)
		if not success then
			warn("Script execution error:", err)
		end
	end
end)

-- Clear editor
Clear.MouseButton1Click:Connect(function()
	Editor.Text = ""
end)

-- Dragging GUI
local dragging, dragInput, dragStart, startPos
MainGUI.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = MainGUI.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)
MainGUI.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		dragInput = input
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		MainGUI.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

